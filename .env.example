# ---- Required ----

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Anthropic API key — every logged meal is one claude-haiku-4-5 call
ANTHROPIC_API_KEY=sk-ant-...

# Your personal Telegram chat ID. Every message from any other chat is ignored.
# See the README for how to find it.
AUTHORIZED_CHAT_ID=123456789

# Random string used two ways: as Telegram's webhook secret-token header, and
# (hashed) as the unguessable webhook URL path.
#
# Telegram only accepts A-Z, a-z, 0-9, _ and - here — no other punctuation, so
# do not use a password generator with symbols turned on. Generate with:
#   openssl rand -hex 32
WEBHOOK_SECRET=replace-me-with-a-long-random-hex-string

# ---- Optional (defaults shown) ----

# Model per input path. Text descriptions are unambiguous and the cheap model
# handles them well; photos are a much harder perception problem, so they use a
# stronger one. Set PHOTO_MODEL=claude-haiku-4-5 to halve photo cost at the
# expense of identification accuracy.
TEXT_MODEL=claude-haiku-4-5
PHOTO_MODEL=claude-sonnet-5

# Longest edge photos are resized to before upload. 1568 is the largest edge
# the model reads at full detail. Lowering it saves tokens but loses the fine
# texture that separates rice from mashed potato.
PHOTO_MAX_EDGE=1568

# IANA timezone. Drives the "local day" boundaries and the 21:00 summary.
# Change this single variable when you travel.
TZ=America/Chicago

# SQLite file. On Railway this MUST be inside the mounted volume (/data).
DB_PATH=/data/foodlog.db

# HTTP port inside the container. This must match the port you enter when
# generating the Railway domain. Railway usually injects it; setting it
# explicitly to 8080 on both sides removes any chance of a mismatch.
PORT=8080

# Public HTTPS base URL for the Telegram webhook. On Railway this is derived
# automatically from RAILWAY_PUBLIC_DOMAIN — only set it manually if you are
# fronting the service with your own domain or tunnelling for local testing.
# PUBLIC_URL=https://dialedbot-production.up.railway.app
