# ---- Required ----

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Anthropic API key (used only on fallback/photo paths — see README)
ANTHROPIC_API_KEY=sk-ant-...

# Nutritionix credentials (free tier) — https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=abc12345
NUTRITIONIX_API_KEY=0123456789abcdef0123456789abcdef

# Your personal Telegram chat ID. Every message from any other chat is ignored.
# See the README for how to find it.
AUTHORIZED_CHAT_ID=123456789

# Random string used two ways: as Telegram's webhook secret-token header, and
# (hashed) as the unguessable webhook URL path. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# ---- Optional (defaults shown) ----

# IANA timezone. Drives the "local day" boundaries and the 21:00 summary.
# Change this single variable when you travel.
TZ=America/Chicago

# SQLite file. On Railway this MUST be inside the mounted volume (/data).
DB_PATH=/data/foodlog.db

# HTTP port. Railway injects this automatically; only set it for local runs.
PORT=3000

# Public HTTPS base URL for the Telegram webhook. On Railway this is derived
# automatically from RAILWAY_PUBLIC_DOMAIN — only set it manually if you are
# fronting the service with your own domain or tunnelling for local testing.
# PUBLIC_URL=https://dialedbot-production.up.railway.app
